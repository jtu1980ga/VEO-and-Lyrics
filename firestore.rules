rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile and private data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /keywords/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /lyrics/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /videos/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /chats/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
